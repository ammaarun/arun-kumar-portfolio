# ==========================================
# Universal Multi-Client Portfolio CMS
# Environment Configuration Template
# ==========================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Secret
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# ------------------------------------------
# Gmail SMTP Email Notification Configuration
# ------------------------------------------
# To receive real email notifications in Gmail:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password" under Security > 2-Step Verification > App Passwords:
#    Select App: "Mail", Device: "Other" (e.g. Portfolio CMS).
# 3. Google generates a 16-character password (e.g., abcd efgh ijkl mnop).
# 4. Set SMTP_USER to your Gmail and SMTP_PASS to that 16-character App Password.
# Note: Never use your normal Gmail account password.

SMTP_USER=your_email@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional: Default fallback recipient email if not configured in the portfolio admin settings
NOTIFICATION_EMAIL=your_email@gmail.com

# Optional: Custom From header
EMAIL_FROM="Portfolio Alerts" <your_email@gmail.com>

# ------------------------------------------
# Neon Object Storage (S3-Compatible)
# ------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=
